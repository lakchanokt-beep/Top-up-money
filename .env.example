PORT=3000

# Local port-forward defaults:
DCB_BASE_URL=http://localhost:8051
DDP_ACCOUNT_FINANCIAL_URL=http://localhost:8070/payment/v1/internal/deposit-adapter/account-financial
DCB_TRANSFER_PATH=/api/v1/transfer

# Internal cluster examples:
# DCB_BASE_URL=http://payment-internal-common-dcb-adapter.payment-internal.svc.cluster.local:8080
# DDP_ACCOUNT_FINANCIAL_URL=http://payment-internal-common-deposit-adapter.payment-internal.svc.cluster.local:8080/payment/v1/internal/deposit-adapter/account-financial

