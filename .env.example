PORT=3000

# Local port-forward defaults:
DCB_SIT_BASE_URL=http://127.0.0.2:8051
DCB_UAT_BASE_URL=http://localhost:28051
DDP_SIT_ACCOUNT_FINANCIAL_URL=http://127.0.0.2:8070/payment/v1/internal/deposit-adapter/account-financial
DDP_UAT_ACCOUNT_FINANCIAL_URL=http://localhost:28070/payment/v1/internal/deposit-adapter/account-financial
DCB_TRANSFER_PATH=/api/v1/transfer

CARDLESS_WITHDRAWAL_SIT_BASE_URL=http://127.0.0.2:8081
CARDLESS_WITHDRAWAL_UAT_BASE_URL=http://localhost:28081
CARDLESS_DEPOSIT_SIT_BASE_URL=http://127.0.0.2:8045
CARDLESS_DEPOSIT_UAT_BASE_URL=http://localhost:28045
CARDLESS_DEPOSIT_DEVOPS_KEY=replace-with-internal-key

# Internal cluster examples:
# DCB_SIT_BASE_URL=http://payment-internal-common-dcb-adapter.payment-internal.svc.cluster.local:8080
# DCB_UAT_BASE_URL=http://payment-internal-common-dcb-adapter.payment-internal.svc.cluster.local:8080
# DDP_SIT_ACCOUNT_FINANCIAL_URL=http://payment-internal-common-deposit-adapter.payment-internal.svc.cluster.local:8080/payment/v1/internal/deposit-adapter/account-financial
# DDP_UAT_ACCOUNT_FINANCIAL_URL=http://payment-internal-common-deposit-adapter.payment-internal.svc.cluster.local:8080/payment/v1/internal/deposit-adapter/account-financial

AUDIT_LOG_PATH=logs/audit.jsonl

# Optional. Set both values to enable browser basic auth.
# BASIC_AUTH_USER=topup
# BASIC_AUTH_PASSWORD=change-me
